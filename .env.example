
# Application
APP_NAME=MyApplication
APP_ENV=development
APP_DEBUG=false

# Application URL
APP_URL=http://localhost:8000

# Database
DATABASE_URL=

# Security
SECRET_KEY=replace_with_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=INFO

# Timezone
TIMEZONE=Asia/Tehran
